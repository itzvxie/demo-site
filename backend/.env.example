# Anthropic API key - required for /api/process-study-material. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Port the Express server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your Next.js frontend).
# Must be an exact origin (e.g. https://your-site.vercel.app), not "*" - cookies require it.
CORS_ORIGIN=http://localhost:3000

# --- Authentication ---------------------------------------------------------

# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string - used to sign session cookies and hash email codes.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Your Next.js site's URL, used to redirect back after Apple Sign In.
FRONTEND_ORIGIN=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> your Services ID
APPLE_SERVICES_ID=

# Resend (resend.com) API key, and the "from" address login-code emails are sent from.
# The default below is Resend's shared test sender, which only delivers to your own
# Resend account email until you verify a real domain.
RESEND_API_KEY=
EMAIL_FROM=Novalis AI <onboarding@resend.dev>
