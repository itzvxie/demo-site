# Google Gemini API key - required for /api/process-study-material. Free,
# no credit card needed - get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port the Express server listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your Next.js frontend).
# Must be an exact origin (e.g. https://your-site.vercel.app), not "*" - cookies require it.
CORS_ORIGIN=http://localhost:3000

# --- Authentication ---------------------------------------------------------

# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Any long random string - used to sign session cookies and hash email codes.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Your Next.js site's URL, used to redirect back after Apple Sign In.
FRONTEND_ORIGIN=http://localhost:3000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> your Services ID
APPLE_SERVICES_ID=

# Resend (https://resend.com) - used to send "reset your password" emails.
# Get an API key at resend.com/api-keys. EMAIL_FROM must be an address on a
# domain you've verified in Resend (or leave unset to use their test sender,
# which can only send to the email you signed up to Resend with).
RESEND_API_KEY=
EMAIL_FROM=Novalis AI <onboarding@resend.dev>
