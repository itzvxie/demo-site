# Base URL of the Novalis AI backend (see /backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Safe to expose publicly - this is a client ID, not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> your Services ID.
# Also safe to expose publicly.
NEXT_PUBLIC_APPLE_CLIENT_ID=
